rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOrganizer() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }
    
    function isOrganizerOrAdmin() {
      return isAdmin() || isOrganizer();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isEventOwner(eventData) {
      return isAuthenticated() && request.auth.uid == eventData.organizerId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile during signup
      allow create: if isOwner(userId) && 
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email;
      
      // Users can update their own profile (except role and isApproved)
      allow update: if isOwner(userId) && 
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.isApproved == resource.data.isApproved;
      
      // Only admins can update role and approval status
      allow update: if isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      // Anyone can read approved and active events
      allow read: if resource.data.isApproved == true && resource.data.isActive == true;
      
      // Organizers and admins can read all events
      allow read: if isOrganizerOrAdmin();
      
      // Approved organizers can create events
      allow create: if isOrganizer() && 
                       request.resource.data.organizerId == request.auth.uid &&
                       request.resource.data.isApproved == false; // Events need admin approval
      
      // Event owners and admins can update events
      allow update: if (isEventOwner(resource.data) && resource.data.isApproved == false) || 
                       isAdmin();
      
      // Event owners and admins can delete events
      allow delete: if isEventOwner(resource.data) || isAdmin();
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Users can read their own registrations, organizers can read registrations for their events
      allow read: if isOwner(resource.data.userId) || 
                     isEventOwner(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data) ||
                     isAdmin();
      
      // Authenticated users can register for events
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.userEmail == request.auth.token.email;
      
      // Users can cancel their own registrations
      allow update: if isOwner(resource.data.userId) && 
                       request.resource.data.status == 'cancelled';
      
      // Event organizers and admins can update registration status
      allow update: if isEventOwner(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data) ||
                       isAdmin();
      
      // Users can delete their own registrations, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(resource.data.userId);
      
      // System and admins can create notifications
      allow create: if isAdmin();
      
      // Users can update their own notifications (mark as read)
      allow update: if isOwner(resource.data.userId);
      
      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Everyone can read active announcements
      allow read: if resource.data.isActive == true;
      
      // Admins can read all announcements
      allow read: if isAdmin();
      
      // Only admins can create, update, and delete announcements
      allow create, update, delete: if isAdmin();
    }

    // Analytics collection (admin only)
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}